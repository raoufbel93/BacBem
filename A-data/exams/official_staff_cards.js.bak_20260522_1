function normalizeStaffTeacherName(value) {
    var text = String(value || '').trim();
    if (!text) return '';

    try {
        if (text.normalize) text = text.normalize('NFKC');
    } catch (e) { }

    return text
        .replace(/[\u064B-\u065F\u0670\u0640]/g, '')
        .replace(/[ط£ط¥ط¢]/g, 'ط§')
        .replace(/ظ‰/g, 'ظٹ')
        .replace(/ط¤/g, 'ظˆ')
        .replace(/ط¦/g, 'ظٹ')
        .replace(/ط©/g, 'ظ‡')
        .replace(/\s+/g, ' ')
        .trim();
}

