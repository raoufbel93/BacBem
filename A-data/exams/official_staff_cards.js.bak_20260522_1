    var dateFormatted = date.toLocaleDateString('ar-DZ', { day: '2-digit', month: '2-digit', year: 'numeric' });
    return { dayName: dayName, dateFormatted: dateFormatted, full: dayName + ' ' + dateFormatted };
}

